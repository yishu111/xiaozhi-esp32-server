<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Template only. Do not point ProgramArguments at ~/Desktop: launchd has been
  denied that folder, and this template does not request Full Disk Access.
  Leave RunAtLoad and KeepAlive false until a foreground start_xiaozhi.sh
  run has been checked by hand. Do not bootstrap this plist as root.
-->
<dict>
  <key>Label</key>
  <string>com.xiaozhi.server</string>
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <false/>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPLACE_WITH_START_SCRIPT</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>XIAOZHI_SERVER_DIR</key>
    <string>REPLACE_WITH_SERVER_DIR</string>
    <key>XIAOZHI_PYTHON</key>
    <string>REPLACE_WITH_PYTHON</string>
    <key>XIAOZHI_MEM0_HOST</key>
    <string>127.0.0.1</string>
    <key>XIAOZHI_MEM0_PORT</key>
    <string>8888</string>
  </dict>
  <key>StandardOutPath</key>
  <string>REPLACE_WITH_LOG_DIR/xiaozhi.out.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_WITH_LOG_DIR/xiaozhi.err.log</string>
</dict>
</plist>
